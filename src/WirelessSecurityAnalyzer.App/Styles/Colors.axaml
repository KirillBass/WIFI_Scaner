<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="WindowBrush" Color="#F0F0F0" />
  <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="BorderBrush" Color="#C0C0C0" />
  <SolidColorBrush x:Key="TextBrush" Color="#202020" />
  <SolidColorBrush x:Key="MutedBrush" Color="#595959" />
  <SolidColorBrush x:Key="AccentBrush" Color="#305D87" />
  <SolidColorBrush x:Key="SignalBrush" Color="#28643C" />
  <SolidColorBrush x:Key="WarningBrush" Color="#805B00" />
  <SolidColorBrush x:Key="HighLoadBrush" Color="#9D4B16" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#A4262C" />
</ResourceDictionary>
