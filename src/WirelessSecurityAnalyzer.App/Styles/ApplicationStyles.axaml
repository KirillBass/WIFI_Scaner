<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WirelessSecurityAnalyzer.App.ViewModels">
  <Styles.Resources>
    <DataTemplate x:Key="WifiErrorTemplate" x:DataType="vm:WifiViewModelBase">
      <Border Classes="card" BorderBrush="{DynamicResource ErrorBrush}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" />
          <Button Content="Открыть параметры местоположения" Command="{Binding OpenLocationSettingsCommand}" IsVisible="{Binding IsLocationPermissionRequired}" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Styles.Resources>
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontFamily" Value="Segoe UI, sans-serif" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.section"><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.subtitle"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="10" />
  </Style>
  <Style Selector="Button">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="TextBox"><Setter Property="CornerRadius" Value="0" /></Style>
  <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="0" /></Style>
  <Style Selector="TabStripItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,8" />
  </Style>
  <Style Selector="TableView"><Setter Property="Background" Value="{DynamicResource CardBrush}" /></Style>
  <Style Selector="TableViewRow">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="TableViewCell"><Setter Property="Padding" Value="6,3" /></Style>
  <Style Selector="TableViewColumnHeader">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="6,6" />
  </Style>
</Styles>
