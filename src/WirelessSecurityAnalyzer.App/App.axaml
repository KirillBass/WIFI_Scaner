<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WirelessSecurityAnalyzer.App.ViewModels"
             xmlns:views="using:WirelessSecurityAnalyzer.App.Views"
             x:Class="WirelessSecurityAnalyzer.App.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Styles/Colors.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="/Styles/ApplicationStyles.axaml" />
  </Application.Styles>
  <Application.DataTemplates>
    <DataTemplate DataType="vm:DashboardViewModel"><views:DashboardView /></DataTemplate>
    <DataTemplate DataType="vm:AccessPointsViewModel"><views:AccessPointsView /></DataTemplate>
    <DataTemplate DataType="vm:ChannelsViewModel"><views:ChannelsView /></DataTemplate>
    <DataTemplate DataType="vm:SignalViewModel"><views:SignalView /></DataTemplate>
    <DataTemplate DataType="vm:DevicesViewModel"><views:DevicesView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
  </Application.DataTemplates>
</Application>
