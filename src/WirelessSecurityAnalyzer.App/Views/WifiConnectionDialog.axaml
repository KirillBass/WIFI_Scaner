<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WirelessSecurityAnalyzer.App.ViewModels" xmlns:models="using:WirelessSecurityAnalyzer.Core.Models"
        x:Class="WirelessSecurityAnalyzer.App.Views.WifiConnectionDialog" x:DataType="vm:WifiConnectionDialogViewModel"
        Title="Подключение к Wi-Fi" Width="540" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="10">
    <TextBlock Text="Подключение к сети" Classes="title" />
    <TextBlock Text="{Binding Ssid, StringFormat='SSID: {0}'}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Bssid, StringFormat='Выбранный BSSID: {0}'}" />
    <TextBlock Text="{Binding Security, StringFormat='Безопасность: {0}'}" />
    <TextBlock Text="Wi-Fi адаптер:" />
    <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch">
      <ComboBox.ItemTemplate><DataTemplate x:DataType="models:WifiAdapter"><TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <StackPanel IsVisible="{Binding RequiresPassword}" Spacing="5">
      <TextBlock Text="Пароль:" />
      <TextBox x:Name="PasswordInput" Text="{Binding Password, Mode=TwoWay}" PasswordChar="●" MaxLength="64" IsEnabled="{Binding CanEdit}" />
    </StackPanel>
    <TextBlock Text="Пароль не требуется." IsVisible="{Binding !RequiresPassword}" />
    <TextBlock Text="Временный профиль. Приложение не сохраняет пароль. Windows выбирает подходящую точку данного SSID." Classes="subtitle" />
    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />
    <TextBlock Text="{Binding Session.Status}" IsVisible="{Binding IsBusy}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CancelButton" Content="Отмена / Закрыть" />
      <Button Content="Подключиться" Command="{Binding ConnectCommand}" />
    </StackPanel>
  </StackPanel>
</Window>
