<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WirelessSecurityAnalyzer.App.ViewModels" x:Class="WirelessSecurityAnalyzer.App.Views.DashboardView" x:DataType="vm:DashboardViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
  <StackPanel Spacing="12">
    <TextBlock Text="Обзор" Classes="title" />
    <TextBlock Text="Сводка последнего успешного сканирования" Classes="subtitle" />
    <Grid ColumnDefinitions="200,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="16">
      <TextBlock Text="Всего точек доступа (BSS):" />
      <TextBlock Grid.Column="1" Text="{Binding AccessPoints.TotalCount}" />
      <TextBlock Grid.Row="1" Text="В диапазоне 2,4 ГГц:" />
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AccessPoints.Ghz24Count}" />
      <TextBlock Grid.Row="2" Text="В диапазоне 5 ГГц:" />
      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AccessPoints.Ghz5Count}" />
      <TextBlock Grid.Row="3" Text="В диапазоне 6 ГГц:" />
      <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AccessPoints.Ghz6Count}" />
    </Grid>
    <Separator />
    <StackPanel Spacing="8">
      <TextBlock Text="Wi-Fi адаптеры" Classes="section" />
      <TextBlock Text="{Binding AccessPoints.AdapterText}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding AccessPoints.StatusText}" Classes="subtitle" />
      <Button Content="Сканировать эфир" Command="{Binding AccessPoints.ScanCommand}" HorizontalAlignment="Left" />
    </StackPanel>
    <Separator />
    <StackPanel Spacing="8">
      <TextBlock Text="Мониторинг сигнала" Classes="section" />
      <TextBlock Text="{Binding Signal.StatusText}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Signal.SelectedSsid, StringFormat='Сеть: {0}'}" />
      <TextBlock Text="{Binding Signal.SelectedBssid, StringFormat='BSSID: {0}'}" />
      <TextBlock Text="{Binding Signal.CurrentRssiText, StringFormat='Текущий RSSI: {0}'}" />
    </StackPanel>
    <TextBlock Text="Подробные данные доступны на вкладках «Эфир», «Каналы», «Сигнал» и «Устройства»." Classes="subtitle" />
  </StackPanel>
  </ScrollViewer>
</UserControl>
