<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WirelessSecurityAnalyzer.App.ViewModels" x:Class="WirelessSecurityAnalyzer.App.Views.SettingsView" x:DataType="vm:SettingsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
  <StackPanel Spacing="12">
    <TextBlock Text="Настройки" Classes="title" />
    <StackPanel Spacing="8"><TextBlock Text="Разрешения Windows" Classes="section" /><TextBlock Text="Для доступа к BSSID и окружающим сетям Windows может требовать разрешение определения местоположения. Включите его для классических приложений." Classes="subtitle" /><Button Content="Открыть параметры местоположения" Command="{Binding AccessPoints.OpenLocationSettingsCommand}" HorizontalAlignment="Left" /></StackPanel>
    <Separator />
    <StackPanel Spacing="8"><TextBlock Text="Локальные журналы" Classes="section" /><TextBlock Text="{Binding LogsDirectory}" TextWrapping="Wrap" /><TextBlock Text="Сохраняются 14 последних файлов журналов. Данные сетей и журналы не отправляются в интернет." Classes="subtitle" /></StackPanel>
    <TextBlock Text="Интервал мониторинга 5–60 секунд можно выбрать в разделе «Сигнал». История хранится в памяти до закрытия приложения." Classes="subtitle" />
  </StackPanel>
  </ScrollViewer>
</UserControl>
