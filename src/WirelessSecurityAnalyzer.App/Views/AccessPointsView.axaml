<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WirelessSecurityAnalyzer.App.ViewModels" xmlns:controls="using:WirelessSecurityAnalyzer.App.Controls"
             x:Class="WirelessSecurityAnalyzer.App.Views.AccessPointsView" x:DataType="vm:AccessPointsViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" RowSpacing="8">
    <StackPanel Spacing="4"><TextBlock Text="Эфир" Classes="title" /><TextBlock Text="Доступные точки доступа" Classes="subtitle" /><TextBlock Text="{Binding AdapterText}" Classes="subtitle" /></StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
      <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button Grid.Column="1" Content="Подключиться" Command="{Binding ConnectCommand}" />
      <Button Grid.Column="2" Content="Сканировать" Command="{Binding ScanCommand}" />
      <Button Grid.Column="3" Content="Отмена" Command="{Binding ScanCancelCommand}" IsVisible="{Binding IsBusy}" />
    </Grid>
    <ContentControl Grid.Row="2" Content="{Binding}" ContentTemplate="{StaticResource WifiErrorTemplate}" IsVisible="{Binding HasError}" />
    <Grid Grid.Row="3" ColumnDefinitions="*,170,Auto" ColumnSpacing="12">
      <TextBox PlaceholderText="Поиск по SSID или BSSID" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding BandFilters}" SelectedIndex="{Binding SelectedBandIndex}" HorizontalAlignment="Stretch" />
      <CheckBox Grid.Column="2" Content="Сильные сверху" IsChecked="{Binding StrongestFirst}" />
    </Grid>
    <Border Grid.Row="4" Classes="card" Padding="0" ClipToBounds="True">
      <Grid>
        <TableView ItemsSource="{Binding AccessPoints}" SelectedItem="{Binding SelectedAccessPoint, Mode=TwoWay}"
                   CanUserResizeColumns="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.AllowAutoHide="False">
          <TableView.Columns>
            <TableViewColumn Header="SSID" Binding="{ReflectionBinding Ssid}" Width="145" />
            <TableViewColumn Header="BSSID" Binding="{ReflectionBinding Bssid}" Width="150" />
            <TableViewColumn Header="Производитель" Width="140">
              <TableViewColumn.CellTemplate><DataTemplate x:DataType="vm:AccessPointRowViewModel">
                <TextBlock Text="{Binding Vendor}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Vendor}" />
              </DataTemplate></TableViewColumn.CellTemplate>
            </TableViewColumn>
            <TableViewColumn Header="RSSI / сигнал" Width="130">
              <TableViewColumn.CellTemplate><DataTemplate x:DataType="vm:AccessPointRowViewModel"><controls:SignalStrengthControl RssiDbm="{Binding RssiDbm}" /></DataTemplate></TableViewColumn.CellTemplate>
            </TableViewColumn>
            <TableViewColumn Header="Канал" Binding="{ReflectionBinding Channel}" Width="60" />
            <TableViewColumn Header="Диапазон" Binding="{ReflectionBinding Band}" Width="90" />
            <TableViewColumn Header="Стандарт Wi-Fi" Binding="{ReflectionBinding WifiStandard}" Width="150" />
            <TableViewColumn Header="Безопасность" Width="165">
              <TableViewColumn.CellTemplate><DataTemplate x:DataType="vm:AccessPointRowViewModel">
                <TextBlock Text="{Binding Security}" ToolTip.Tip="{Binding SecurityDetails}" />
              </DataTemplate></TableViewColumn.CellTemplate>
            </TableViewColumn>
            <TableViewColumn Header="Частота" Binding="{ReflectionBinding Frequency}" Width="100" />
            <TableViewColumn Header="Обнаружена" Binding="{ReflectionBinding LastSeen}" Width="120" />
          </TableView.Columns>
        </TableView>
        <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="24">
          <TextBlock Text="Нет точек доступа для отображения" HorizontalAlignment="Center" />
          <TextBlock Text="Выполните сканирование или измените фильтры." Classes="subtitle" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="5" Classes="card" IsVisible="{Binding HasSelectedAccessPoint}">
      <StackPanel Spacing="6">
        <TextBlock Text="Выбранная точка доступа" FontWeight="SemiBold" />
        <TextBlock Text="{Binding SelectedAccessPoint.Details}" TextWrapping="Wrap" />
        <TextBlock Text="Вендор — владелец OUI, а не модель роутера. Защита — объявленные режимы BSS, а не параметры подключения клиента." Classes="subtitle" TextWrapping="Wrap" />
        <TextBlock Text="{Binding ConnectionHint}" Classes="subtitle" />
      </StackPanel>
    </Border>
    <Grid Grid.Row="6" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
      <ProgressBar Grid.ColumnSpan="2" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />
      <TextBlock Grid.Row="1" Text="{Binding LastScanText}" Classes="subtitle" />
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalCount, StringFormat='Всего BSS: {0}'}" Classes="subtitle" />
    </Grid>
  </Grid>
</UserControl>
